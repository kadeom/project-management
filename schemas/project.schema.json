{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kadeom/project-management/schemas/project.schema.json",
  "title": "project.yaml",
  "description": "Контракт данных учебного проекта (CONF-2026 и варианты ДЗ). Исполняемая проверка — src/pm/model.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project",
    "calendar",
    "resources",
    "phases"
  ],
  "properties": {
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "short",
        "start"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "short": {
          "type": "string",
          "minLength": 1
        },
        "author": {
          "type": "string"
        },
        "company": {
          "type": "string"
        },
        "start": {
          "type": "string",
          "format": "date"
        },
        "currency": {
          "type": "string"
        },
        "currency_code": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "repo": {
          "type": "string",
          "format": "uri"
        },
        "budget_rub": {
          "type": "number",
          "minimum": 0
        },
        "variant": {
          "type": "integer",
          "minimum": 1
        },
        "system": {
          "type": "string"
        },
        "variant_note": {
          "type": "string"
        }
      }
    },
    "calendar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "work_hours"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "work_hours": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "string",
              "pattern": "^[0-2][0-9]:[0-5][0-9]$"
            }
          }
        },
        "exceptions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "from",
              "to"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "from": {
                "type": "string",
                "format": "date"
              },
              "to": {
                "type": "string",
                "format": "date"
              }
            }
          }
        }
      }
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/resource"
      }
    },
    "work_codes": {
      "$ref": "#/$defs/codeTree"
    },
    "dept_codes": {
      "$ref": "#/$defs/codeTree"
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "tasks"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "tasks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/task"
            }
          }
        }
      }
    },
    "fx": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "source",
        "usd",
        "rub"
      ],
      "properties": {
        "date": {
          "type": "string",
          "format": "date"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "usd": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "rub": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "cost_basis": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item",
          "price",
          "unit",
          "basis"
        ],
        "properties": {
          "item": {
            "type": "string"
          },
          "price": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "basis": {
            "type": "string"
          },
          "market": {
            "type": "string"
          }
        }
      }
    },
    "report": {
      "type": "object",
      "description": "Тексты заданий практической работы; структуру проверяет report_infosec."
    }
  },
  "$defs": {
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "name"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "work",
            "material",
            "cost"
          ],
          "default": "work"
        },
        "role": {
          "type": "string"
        },
        "initials": {
          "type": "string"
        },
        "group": {
          "type": "string"
        },
        "dept": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "rate": {
          "type": "number",
          "minimum": 0
        },
        "ot": {
          "type": "number",
          "minimum": 0
        },
        "rate_b": {
          "type": "number",
          "minimum": 0
        },
        "per_use": {
          "type": "number",
          "minimum": 0
        },
        "rate_change": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "from",
            "rate"
          ],
          "properties": {
            "from": {
              "type": "string",
              "format": "date"
            },
            "rate": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "availability": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "units"
            ],
            "properties": {
              "from": {
                "type": "string",
                "format": "date"
              },
              "to": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date"
              },
              "units": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        },
        "currency": {
          "enum": [
            "KGS",
            "RUB",
            "USD"
          ],
          "description": "Валюта цены ресурса; пересчёт выполняет currency.apply_fx."
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "name"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "dur": {
          "type": "number",
          "minimum": 0
        },
        "pert": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "after": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*(:(ОН|НН|ОО|НО)([+-][0-9]+(\\.[0-9]+)?)?)?$"
          }
        },
        "res": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        },
        "code": {
          "type": "string",
          "pattern": "^[^.]+\\.[^.]+$"
        },
        "note": {
          "type": "string"
        },
        "link": {
          "type": "string",
          "format": "uri"
        },
        "constraint": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "date"
          ],
          "properties": {
            "type": {
              "enum": [
                "SNET",
                "SNLT",
                "FNET",
                "FNLT",
                "MSO",
                "MFO"
              ]
            },
            "date": {
              "type": "string",
              "format": "date"
            }
          }
        },
        "deadline": {
          "type": "string",
          "format": "date"
        },
        "fixed_cost": {
          "type": "number",
          "minimum": 0
        },
        "accrual": {
          "enum": [
            "start",
            "end",
            "prorated"
          ],
          "default": "prorated"
        }
      }
    },
    "codeTree": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "children"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "children": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
